{
  "name": "heritage-patrol-app",
  "private": true,
  "version": "1.0.0",
  "description": "鄯善文保巡查 App —— 基于 Capacitor + Vant 的文物巡查移动端",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:ui": "node --experimental-vm-modules --test tests/ui-navigation.test.js tests/patrol-steps.test.js tests/patrol-distance.test.js tests/heritage-level.test.js tests/watermark.test.js tests/records-access.test.js",
    "typecheck:location": "vue-tsc -p tsconfig.location.json",
    "test:location": "node --experimental-strip-types --test tests/location-services.test.ts && node --experimental-vm-modules --test tests/location.test.js tests/location-adapter.test.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "vite build && cap sync android",
    "android": "vite build && cap sync android && cap open android",
    "assets": "capacitor-assets generate --android --iconBackgroundColor '#1E5AA8' --splashBackgroundColor '#1E5AA8'",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/inappbrowser": "^4.0.4",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "remixicon": "^4.9.1",
    "vant": "^4.10.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.4",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vue-tsc": "^3.1.0"
  }
}
